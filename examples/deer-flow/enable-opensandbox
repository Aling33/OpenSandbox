#!/usr/bin/env bash
# Switch DeerFlow's sandbox config to OpenSandboxProvider (idempotent).
#
# DeerFlow's config.example.yaml enables LocalSandboxProvider (direct host
# execution) by default. This script locates that section, swaps the `use`
# line to OpenSandboxProvider, and adds the provider options; other section
# fields (output truncation limits etc.) are kept as-is.
#
# Runs automatically on first container start; also safe to run manually
# after `make setup` (or any wizard) overwrites config.yaml.
set -euo pipefail

DEERFLOW_ROOT="${DEER_FLOW_PROJECT_ROOT:-/opt/deer-flow}"
CONFIG="${DEERFLOW_ROOT}/config.yaml"

if [ ! -f "$CONFIG" ]; then
  if [ ! -f "${DEERFLOW_ROOT}/config.example.yaml" ]; then
    echo "enable-opensandbox: ${DEERFLOW_ROOT}/config.example.yaml not found" >&2
    exit 1
  fi
  echo "enable-opensandbox: config.yaml missing, copying config.example.yaml"
  cp "${DEERFLOW_ROOT}/config.example.yaml" "$CONFIG"
fi

python3 - "$CONFIG" <<'PY'
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")

local = "use: deerflow.sandbox.local:LocalSandboxProvider"
provider = "use: deerflow.community.opensandbox:OpenSandboxProvider"
if provider in text:
    print("enable-opensandbox: sandbox.use already OpenSandboxProvider, nothing to do")
    sys.exit(0)
if local not in text:
    sys.exit(
        "enable-opensandbox: default LocalSandboxProvider section not found. "
        "Upstream DeerFlow likely changed the default config layout; edit "
        "config.yaml manually: set sandbox.use to "
        "deerflow.community.opensandbox:OpenSandboxProvider and add the "
        "provider options (image/domain/protocol/...)."
    )

replacement = """\
use: deerflow.community.opensandbox:OpenSandboxProvider
  # ---- OpenSandbox server bundled in this image ----
  image: python:3.11
  domain: localhost:8080
  protocol: http
  ready_timeout: 300        # covers the first sandbox image pull
  replicas: 3
  idle_timeout: 600
"""
# Keep the leading indentation of the original `use:` line: replace only the
# `use: ...` substring itself.
text = text.replace(local, replacement.rstrip("\n"), 1)
path.write_text(text, encoding="utf-8")
print(f"enable-opensandbox: {path}: sandbox.use -> OpenSandboxProvider (domain localhost:8080)")
PY
